{
  "name": "openrm",
  "version": "0.1.0",
  "description": "A WhatsApp-based CRM agent: pair a WhatsApp number via QR code, let an LLM-powered agent reply to inbound customer messages and persist their name, phone number, and interests to Postgres.",
  "type": "module",
  "bin": {
    "openrm": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "web/dist",
    "templates",
    "prisma",
    "README.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && npm run build:web",
    "build:web": "cd web && npm run build",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma || echo 'prisma generate skipped'"
  },
  "keywords": [
    "whatsapp",
    "crm",
    "agent",
    "llm",
    "baileys",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@hapi/boom": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@prisma/client": "^5.22.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "commander": "^12.1.0",
    "express": "^4.21.1",
    "ink": "^5.1.0",
    "libphonenumber-js": "^1.13.11",
    "multer": "^2.0.0",
    "openai": "^4.73.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.12",
    "@types/ws": "^8.5.13",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
