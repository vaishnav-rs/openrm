// Prisma schema for openrm
//
// Datasource: PostgreSQL with the pgvector extension enabled (see
// prisma/migrations/0001_init/migration.sql, which runs
// `CREATE EXTENSION IF NOT EXISTS vector;` before creating tables).
//
// Embedding dimension: Chunk.embedding is an UNCONSTRAINED `vector` column
// (no fixed dimension) -- see prisma/migrations/0005_flexible_embedding_dim
// for why. It was originally hardcoded to vector(1536) (OpenAI's
// text-embedding-3-small size), which broke ingestion for any other
// embedding model with a different output size (e.g. Ollama's
// nomic-embed-text, which is 768-dim, not 1536 -- the original comment here
// was simply wrong about that). pgvector accepts any dimension into an
// unconstrained `vector` column; the only real constraint is that
// retrieve_knowledge's cosine-distance query (src/agent/tools/rag.ts)
// compares the query embedding against stored chunk embeddings, which only
// works when they're the same dimension -- i.e. don't switch embedding
// models without re-ingesting existing documents, or comparisons against
// old chunks embedded at a different dimension will error.
//
// Migration strategy: this package ships hand-authored SQL migrations
// (prisma/migrations/**) rather than relying on `prisma migrate dev`
// (which requires a live, empty dev database and interactive prompts --
// unsuitable for a globally-installed CLI). At onboarding time, openrm runs
// `prisma migrate deploy` against the user's DATABASE_URL, which is the
// standard, non-interactive, production-safe way to apply migrations for a
// distributed tool. `prisma validate` / `prisma generate` only read this
// schema file and do not require a live database connection.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id            String         @id @default(cuid())
  phone         String         @unique
  // The full WhatsApp JID this contact last messaged from (e.g.
  // "155512345678@s.whatsapp.net" -- or, for accounts on WhatsApp's LID
  // addressing scheme, a "...@lid" JID with a different local part than
  // `phone`). `phone` is only ever the digits parsed out of whichever JID
  // arrived; it is NOT guaranteed to reconstruct back into a valid,
  // routable JID via `${phone}@s.whatsapp.net`, which was the root cause of
  // manual dashboard sends (src/whatsapp/handlers.ts's sendManualMessage)
  // silently succeeding at the Baileys API layer while never actually
  // reaching the phone -- the guessed JID simply didn't resolve to a real
  // session. Kept up to date on every inbound message (see
  // src/agent/orchestrator.ts's handleInbound) so it self-heals if
  // WhatsApp's addressing for a contact ever changes; nullable because
  // contacts created before this field existed won't have it until they
  // message in again.
  jid           String?
  name          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  interests     Interest[]
  conversations Conversation[]
}

model Interest {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label     String
  notes     String?
  createdAt DateTime @default(now())

  @@index([contactId])
}

model Conversation {
  id          String    @id @default(cuid())
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  messages    Message[]
  // Set true by the request_human_handoff agent tool (src/agent/tools/handoff.ts)
  // when the customer explicitly asks for a human, or as a genuine last resort.
  // Never set proactively -- see that tool's description for the exact policy.
  needsHuman  Boolean   @default(false)
  escalatedAt DateTime?
  // True while a human staff member has manually taken over this conversation
  // from the dashboard's Conversations screen ("Jump In"), either by pressing
  // the jump-in keybinding or by sending a manual message (see
  // src/tui/screens/ConversationsFeed.tsx and sendManualMessage in
  // src/whatsapp/handlers.ts). While true, src/agent/orchestrator.ts's
  // handleInbound skips the automatic tool-calling reply loop entirely for
  // this conversation, so the bot and a human never reply to the same
  // customer at the same time. Cleared by the explicit "release to bot"
  // action in the same screen -- never a one-way trap. Independent of
  // needsHuman: needsHuman is the agent's own (automatic) escalation signal,
  // humanControlled is the actual "who is driving right now" switch.
  humanControlled Boolean @default(false)

  @@index([contactId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // "user" (customer) | "assistant" (bot reply) | "tool" (tool output, not
  // shown to the model as a normal turn) | "human" (a staff member's manual
  // reply sent from the dashboard's Conversations screen). "human" is a
  // distinct DB/UI role so the dashboard can visually tell a staff reply
  // apart from a bot reply, but src/agent/orchestrator.ts maps "human" ->
  // "assistant" specifically when building the message array sent to
  // provider.chat() -- from the customer's perspective both are just "the
  // business replied", and the model should treat prior human replies as
  // its own conversational turns, not as some other role it might react to.
  role           String
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model ProviderConfig {
  id             String   @id @default(cuid())
  name           String // "ollama" | "openai" | "anthropic" | "openai-compatible"
  apiKey         String?
  baseUrl        String?
  model          String
  embeddingModel String?
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Singleton row, conventionally id = "1".
model AgentConfig {
  id                 String  @id @default("1")
  masterSystemPrompt String  @db.Text
  // Dedicated internal staff WhatsApp number (bare digits, no @s.whatsapp.net
  // suffix) notified by request_human_handoff. Optional: if unset, the
  // handoff tool still flags the conversation for the dashboard but skips
  // sending a WhatsApp notification. Configured from the "System Prompt"
  // TUI screen (src/tui/screens/SystemPrompt.tsx).
  escalationPhone    String?

  // --- Web/API server auth (added for `openrm server`, see src/server/) ---
  // Single-admin-password auth, hashed with Node's built-in crypto.scryptSync
  // (no bcrypt dependency). Both are hex-encoded. Set once, interactively, the
  // first time `openrm server start` runs with no password configured yet
  // (see src/cli/index.ts's `ensureServerPassword`). Null until then, in
  // which case the server refuses to start (never accepts an unauthenticated
  // default password).
  authPasswordHash String?
  authPasswordSalt String?
  // HMAC secret used to sign session cookies issued by POST /api/auth/login.
  // Generated once (crypto.randomBytes) and persisted here so restarting the
  // server does not invalidate every existing browser session. Sessions
  // themselves are tracked in-memory only (a Map in the running worker
  // process) -- this secret is only what lets the server verify a cookie
  // presented by a client was really issued by it.
  sessionSecret    String?
}

model McpServer {
  id        String   @id @default(cuid())
  name      String
  transport String // "stdio" | "http"
  command   String?
  args      String[] @default([])
  url       String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Document {
  id         String   @id @default(cuid())
  filename   String
  sourcePath String
  createdAt  DateTime @default(now())
  chunks     Chunk[]
}

model Chunk {
  id         String                   @id @default(cuid())
  documentId String
  document   Document                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String                   @db.Text
  ordinal    Int
  // Prisma has no native vector type; this is written/read exclusively via
  // raw SQL ($queryRaw/$executeRaw) in src/rag/ingest.ts and
  // src/agent/tools/rag.ts. `Unsupported(...)` lets `prisma generate`/
  // `validate` succeed without Prisma trying to manage the column.
  embedding  Unsupported("vector")?
  createdAt  DateTime                 @default(now())

  @@index([documentId])
}
